{
  "name": "editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundles": "pnpm --silent --filter @ivt/player --filter @ivt/scorm run build --logLevel error",
    "dev": "pnpm --silent bundles && vite",
    "build": "pnpm --silent bundles && vite build",
    "test": "pnpm --silent bundles && vitest run",
    "e2e": "pnpm --silent bundles && playwright test --trace off",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ivt/player": "workspace:*",
    "@ivt/schema": "workspace:*",
    "@ivt/scorm": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "idb-keyval": "^6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "vite": "5.4.21",
    "vitest": "^2.1.0"
  }
}
